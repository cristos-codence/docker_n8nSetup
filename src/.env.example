# ngrok authentication token
# Sign up at https://dashboard.ngrok.com and get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ngrok domain
# 1. Create an ngrok account at https://dashboard.ngrok.com/signup
# 2. After signing up, ngrok provides a free static domain for your account
# 3. You can find/create your domain at https://dashboard.ngrok.com/cloud-edge/domains
# 4. Enter your FULL domain below (e.g., "myapp.ngrok-free.app") including the domain suffix
NGROK_DOMAIN=your-domain.ngrok-free.app
